rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Safety Net (Default Deny)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@\\.]+$');
    }

    function isSafePublicPayload() {
      return !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data);
    }

    // Connection test path
    match /test/{docId} {
      allow read: if true;
    }

    // 0. Roles & Admin Logs
    match /roles/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isSafePublicPayload();
      allow delete: if isValidId(userId);
    }

    match /adminLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) &&
        request.resource.data.adminEmail is string &&
        request.resource.data.adminEmail.size() <= 200 &&
        request.resource.data.actionUrdu is string &&
        request.resource.data.actionUrdu.size() <= 500;
      allow update, delete: if false;
    }

    // 1. Public Village Directory Profiles (/profiles/{profileId})
    // Strictly forbids storing email, username, or password in public documents
    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if isValidId(profileId) &&
        isSafePublicPayload() &&
        !('email' in request.resource.data) &&
        !('username' in request.resource.data) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 200;
      allow delete: if isValidId(profileId);
    }

    // 1b. Private User Account Details (/profilePrivate/{userId})
    match /profilePrivate/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isSafePublicPayload();
      allow delete: if isValidId(userId);
    }

    // 2. Mosques & Prayer Timings (/mosques/{mosqueId})
    match /mosques/{mosqueId} {
      allow read: if true;
      allow create, update: if isValidId(mosqueId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 250;
      allow delete: if isValidId(mosqueId);
    }

    // 3. Schools, Colleges & Timetables (/institutes/{instituteId})
    match /institutes/{instituteId} {
      allow read: if true;
      allow create, update: if isValidId(instituteId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 250;
      allow delete: if isValidId(instituteId);
    }

    // 4. Public Transport & Jhang Van Schedules (/transports/{transportId})
    match /transports/{transportId} {
      allow read: if true;
      allow create, update: if isValidId(transportId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 250;
      allow delete: if isValidId(transportId);
    }

    // 5. Hospitals, Clinics & Emergency Directory (/hospitals/{hospitalId})
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow create, update: if isValidId(hospitalId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 250;
      allow delete: if isValidId(hospitalId);
    }

    // 6. Village News & Banner Slides (/newsEvents/{eventId} & /bannerImages/{eventId})
    match /newsEvents/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 300 &&
        !('imageData' in request.resource.data);
      allow delete: if isValidId(eventId);
    }

    match /bannerImages/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId) &&
        request.resource.data.imageData is string &&
        request.resource.data.imageData.size() <= 110000 &&
        request.resource.data.byteSize <= 81920;
      allow delete: if isValidId(eventId);
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isValidId(announcementId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 300;
      allow delete: if isValidId(announcementId);
    }

    // 6b. Flood & Emergency Alerts (/floodAlerts/{alertId})
    match /floodAlerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if isValidId(alertId);
    }

    // 6c. Shelters, Mandi Rates, How-To Help Guides & Custom Keywords
    match /shelters/{shelterId} {
      allow read: if true;
      allow create, update, delete: if isValidId(shelterId);
    }

    match /mandiRates/{rateId} {
      allow read: if true;
      allow create, update, delete: if isValidId(rateId);
    }

    match /helpGuides/{guideId} {
      allow read: if true;
      allow create, update, delete: if isValidId(guideId);
    }

    match /customKeywords/{kwId} {
      allow read: if true;
      allow create, update, delete: if isValidId(kwId);
    }

    // 6d. Community Help Posts & Blood Requests (/helpNotices/{noticeId})
    match /helpNotices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isValidId(noticeId);
    }

    // 7. Confidential Two-Way Messages (/messages/{messageId})
    match /messages/{messageId} {
      allow read: if true;
      allow create, update: if isValidId(messageId) &&
        request.resource.data.messageText is string &&
        request.resource.data.messageText.size() <= 3000;
      allow delete: if isValidId(messageId);
    }

    // 7b. In-App & Push Notifications (/notifications/{notificationId})
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if isValidId(notificationId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 300 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 2000;
      allow delete: if isValidId(notificationId);
    }

    // 7c. Push Subscriptions & Tokens (/pushSubscriptions/{subId})
    match /pushSubscriptions/{subId} {
      allow read: if true;
      allow create, update: if isValidId(subId) &&
        request.resource.data.userKey is string &&
        request.resource.data.userKey.size() <= 128 &&
        request.resource.data.enabled is bool;
      allow delete: if isValidId(subId);
    }

    // 7d. User Notification Preferences (/userNotificationPrefs/{prefId})
    match /userNotificationPrefs/{prefId} {
      allow read: if true;
      allow create, update: if isValidId(prefId) &&
        request.resource.data.inAppEnabled is bool &&
        request.resource.data.soundEnabled is bool &&
        request.resource.data.pushEnabled is bool;
      allow delete: if isValidId(prefId);
    }

    // 7e. Email Notification Triggers & Throttles (/mail/{mailId}, /emailThrottles/{recipientId})
    match /mail/{mailId} {
      allow read: if false;
      allow create: if isValidId(mailId) &&
        request.resource.data.to is list &&
        request.resource.data.to.size() <= 5;
      allow update, delete: if false;
    }

    match /emailThrottles/{recipientId} {
      allow read: if true;
      allow create, update: if isValidId(recipientId);
      allow delete: if false;
    }

    // 8. Deleted Messages Archive Vault
    match /deletedMessagesArchive/{archiveId} {
      allow read, write: if isValidId(archiveId);
    }

    // 9. Admin Violation Reports & Alerts (/adminAlerts/{alertId})
    match /adminAlerts/{alertId} {
      allow read, write: if isValidId(alertId);
    }

    // 10. Portal Settings & Student Progress
    match /settings/{docId} {
      allow read, write: if isValidId(docId);
    }

    match /studentProgress/{studentId} {
      allow read, write: if isValidId(studentId);
    }
  }
}
